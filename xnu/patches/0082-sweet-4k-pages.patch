diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9a748ea..d039495 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -63,6 +63,17 @@ MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
 
+# SWEET_4K=1 (environment): same board, built for ARMv8.0 Cortex-A53 cores that
+# lack the 16K translation granule (Galaxy A02s, Snapdragon 450). 4K pages,
+# no PAN, and the iOS (non-large-memory) kernel layout: a 4K kernel only has
+# 39 address bits, too few for ARM_LARGE_MEMORY's kernel at -2TB.
+# -mcpu, not -march: for macOS targets Apple clang keeps its default CPU
+# (apple-m1) under -march and still emits ARMv8.1 LSE atomics, which the A53
+# does not have. 835769: Cortex-A53 erratum (up to r0p4; the A02s is r0p4).
+ifeq ($(SWEET_4K),1)
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_4K=1 -mcpu=cortex-a53+crypto -mfix-cortex-a53-835769
+endif
+
 
 #
 # Deployment target flag
@@ -336,6 +347,11 @@ LARGE_MEMORY_DEFINE=-DARM_LARGE_MEMORY=1
 ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
+ifeq ($(SWEET_4K),1)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
 
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..8ca09aa 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -28,6 +28,23 @@
 
 #include <machine/asm.h>
 
+#if SWEET_4K
+/*
+ * Cortex-A53 (ARMv8.0) has no LSE CAS. Same try-lock as "casa wOLD, wNEW,
+ * [xADDR]" with OLD = 0: on return wOLD is 0 if the lock was taken (with
+ * acquire), else the non-zero lock value. Retries only on a lost exclusive.
+ */
+.macro TRYLOCK_ACQ old, new, addr, tmp
+1:	ldaxr	\old, [\addr]
+	cbnz	\old, 2f
+	stxr	\tmp, \new, [\addr]
+	cbnz	\tmp, 1b
+	b		3f
+2:	clrex
+3:
+.endmacro
+#endif
+
 /* This section has all the code necessary for the atomic operations supported by
  * OSAtomicFifoEnqueue, OSAtomicFifoDequeue APIs in libplatform.
  *
@@ -273,7 +290,11 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if SWEET_4K
+	TRYLOCK_ACQ w10, w11, x3, w12
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +344,11 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if SWEET_4K
+	TRYLOCK_ACQ w10, w11, x2, w12
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..0f53f03 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1825,7 +1825,7 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) && !SWEET_4K
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
@@ -2179,7 +2179,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
-#if defined(SWEET)
+#if defined(SWEET) && !SWEET_4K
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
@@ -2188,9 +2188,17 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-#if defined(SWEET)
+#if defined(SWEET) && !SWEET_4K
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
+#elif defined(SWEET)
+	/*
+	 * SWEET_4K: without ARM_LARGE_MEMORY the area above low globals is
+	 * kernel heap, so there is no spare block for a framebuffer alias.
+	 * Stop the early console with the VA=PA tables; the serial console
+	 * and the regular fbcon (pe_serial) take over later.
+	 */
+	sweet_early_disable();
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..1b21b74 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -691,8 +691,33 @@ Lkernelcache_base_found:
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+#if SWEET_4K
+	/*
+	 * 4K pages: an L2 block is only 2MB and an L1 entry covers 1GB, so the
+	 * framebuffer need not share the first V=P L2 page with RAM. Find the
+	 * V=P L2 table that covers it and map 16MB (8 blocks; the panel needs
+	 * ~10MB). Skip the alias if RAM did not create that L2 table.
+	 */
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	ldr		x13, [x25, x12, lsl #TTE_SHIFT]
+	tbz		x13, #0, Lsweet_fb_alias_done		// ARM_TTE_VALID
+	tbz		x13, #1, Lsweet_fb_alias_done		// ARM_TTE_TYPE_TABLE
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x13, x12, lsl #TTE_SHIFT
+	mov		x12, #(0x1000000 >> ARM_TT_L2_SHIFT)
+Lsweet_fb_alias_block:
+	str		x11, [x13], #(1 << TTE_SHIFT)
+	add		x11, x11, #(ARM_TT_L2_SIZE)
+	subs	x12, x12, #1
+	b.ne	Lsweet_fb_alias_block
+Lsweet_fb_alias_done:
+#else
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
 #endif
 
 	/* Ensure TTEs are visible */
